# Meta Conversions API - Configurações
# =======================================

# Token de acesso da API de Conversões do Meta
# Obtenha em: https://business.facebook.com/events_manager
META_ACCESS_TOKEN=seu_token_de_acesso_aqui

# Código de teste (opcional - apenas para ambiente de desenvolvimento)
# Obtenha em: Meta Events Manager > Test Events
META_TEST_EVENT_CODE=TEST12345

# Porta do servidor
PORT=3001

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Ambiente (development ou production)
NODE_ENV=development
